# Cloudflare Pages / Netlify header rules.
# Mirrors vercel.json so the site behaves the same on any of the three.
# Rules apply in order; later, more specific matches win.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Font filenames never change — cache them hard.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Photos are NOT content-hashed, and the README tells you to drop
# replacements in under the same filename. A day, then revalidate, so a
# swapped photo goes live without needing a rename.
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Same reasoning — no hashes in these filenames, so always revalidate.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
